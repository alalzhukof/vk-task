    "/api/admin/users": {
      "get": {
        "summary": "Admin searches users; first 100 sorted by username",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
